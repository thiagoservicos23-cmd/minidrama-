# Copie este arquivo para ".env" e ajuste os valores. NUNCA suba o .env para o GitHub.

# ---- Banco de dados ----
# Produção (PostgreSQL, ex.: Neon):
DATABASE_URL="postgresql://usuario:senha@host:5432/neondb?sslmode=require"

# ---- Segurança ----
# Chave que assina os logins (JWT). Use um texto longo e aleatório.
JWT_SECRET="troque-esta-chave-por-algo-longo-e-aleatorio"
PORT=4000

# Endereço público do site (sem barra no final). Usado nos links dos e-mails e no webhook do PIX.
SITE_URL="https://seu-site.onrender.com"

# Só usados quando você roda `npm run seed` (cria o admin). Defina uma senha FORTE.
ADMIN_EMAIL="admin@minidrama.app"
ADMIN_PASSWORD=""

# ---- Pagamentos (SyncPay) ----
SYNCPAY_CLIENT_ID=""
SYNCPAY_CLIENT_SECRET=""
# Texto longo e aleatório. Vira parte do endereço do webhook, para ninguém "fingir" ser a SyncPay.
SYNCPAY_WEBHOOK_SECRET=""

# ---- E-mails (Brevo) ----
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""        # e-mail remetente JÁ VERIFICADO na Brevo
MAIL_FROM_NAME="Mini Drama"
EMAIL_DAILY_LIMIT=250     # plano grátis da Brevo permite 300/dia

# ---- Rotina diária (agendador externo) ----
# Senha que o cron-job.org usa para chamar /api/cron/daily
CRON_SECRET=""

# ---- Upload de vídeo (Bunny.net Stream) ----
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_CDN_HOSTNAME=""

# ---- Vitrine do dia (opcional) ----
# A ordem das novelinhas dentro de cada gênero é embaralhada e vira à 00:00 neste fuso horário (padrão: Brasília).
SHUFFLE_TZ="America/Sao_Paulo"

# ---- Integração API Vorta Drama V2 (https://api.quickplay.my.id) ----
VORTA_API_URL="https://api.quickplay.my.id"
VORTA_API_SECRET=""
VORTA_DEFAULT_CATEGORY="freereels"
VORTA_DEFAULT_LANG="pt"
