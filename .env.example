# Copie este arquivo para ".env" e ajuste os valores.

# Para rodar localmente com SQLite (mais simples, não precisa de conta em lugar nenhum):
DATABASE_URL="file:./dev.db"

# Para produção com PostgreSQL real (Neon, Supabase, Railway, etc.), troque por algo assim:
# DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require"

# Chave secreta usada para assinar os tokens de login (JWT).
# Troque por uma string longa e aleatória antes de colocar no ar.
JWT_SECRET="troque-esta-chave-por-algo-longo-e-aleatorio"

# Upload automático de vídeo direto do painel admin (Bunny.net Stream).
# Encontre esses valores em dash.bunny.net > Stream > sua biblioteca > API.
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
# O domínio de entrega da sua biblioteca (aba "Pull Zone" ou "Overview"), sem https://
BUNNY_CDN_HOSTNAME=""

# Porta em que o servidor vai rodar localmente (a hospedagem define isso sozinha em produção)
PORT=4000
